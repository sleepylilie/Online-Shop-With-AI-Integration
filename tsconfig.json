{
  "compilerOptions": {
    "target": "ES2020",           // в какой стандарт JS компилируется
    "module": "ES2020",           // формат модулей 
    "moduleResolution": "bundler",// как искать импортированные файлы 
    "outDir": "./frontend/js",    // куда складывать скомпилированные .js файлы
    "rootDir": "./frontend/ts",   // где искать исходные .ts файлы
    "strict": true,               // включает строгую проверку типов 
    "esModuleInterop": true       // упрощает импорт 
  },
  "include": ["frontend/ts/**/*"] // компилировать все .ts файлы в папке frontend/ts
}